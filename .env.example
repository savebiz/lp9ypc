# Copy this file to .env.local and fill in the values (.env.local is git-ignored).
# See supabase/README.md for where each value comes from.

# ── Public (safe in the browser) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# ── Server-only secrets (NEVER prefix these with NEXT_PUBLIC_) ───────────────
# Service-role key: used only by server routes (posting, agents). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini API key (AI Studio) for the moderation, job-scraper and career-research
# agents. Use a BILLING-ENABLED project: on the free tier Google may use prompts
# (member posts) to improve its products.
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.8-flash
GEMINI_MODEL=
# Optional second model, tried once when the main model is overloaded (503) or
# hits a per-minute rate limit (429). Leave blank to disable.
GEMINI_FALLBACK_MODEL=
# Random string of 32+ characters. Vercel sends it to the cron routes.
CRON_SECRET=
