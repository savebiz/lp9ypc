# Copy this file to .env.local and fill in both values (.env.local is git-ignored).
# Both come from Supabase → Project Settings → API Keys. See supabase/README.md.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# NEVER add the service_role / secret key to this app.
# It bypasses every security rule in supabase/migrations.
